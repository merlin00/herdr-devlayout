# devlayout settings example
# Copy to: $(herdr plugin config-dir merlin00.devlayout)/config.env
# This file is read as POSIX sh (sourced). Quote values that contain spaces.
# The commented-out values are the defaults.

# ── agent (top left) ──
# DEVLAYOUT_AGENT_NAME=claude                 # agent name as herdr detects it (the `agent` value in herdr pane list)
# DEVLAYOUT_AGENT_CMD=claude                  # command for a new session
# DEVLAYOUT_AGENT_RESUME_CMD='claude --continue'  # command to resume the last conversation (repair / reset)
# DEVLAYOUT_AGENT_SETTLE=5                    # if the agent pane's shell started less than this many seconds ago,
                                              # wait that long first: herdr may be resuming the agent there
# DEVLAYOUT_RESUME_GRACE=60                   # if resuming fails within this many seconds, start a new session
                                              # (allows for slow start-up right after a reboot)

# ── editor (bottom left) ──
# DEVLAYOUT_EDITOR=nvim                       # with nvim, it is started with --listen so reviewr etc. can open files in it
# DEVLAYOUT_EDITOR_CMD=                       # if set, replaces the whole editor command (e.g. 'hx')
# DEVLAYOUT_SOCKET_DIR="$HOME/.cache/nvim"    # socket: <this dir>/<folder name>-<path hash>.sock (see: devlayout editor-socket)

# ── review (right) ──
# DEVLAYOUT_REVIEW_CMD=herdr-reviewr

# ── automatic layout for new worktree workspaces ──
# DEVLAYOUT_WORKTREE=0                        # 1: build the layout when herdr creates/opens a worktree workspace
                                              # (set auto_open = false in reviewr's config.toml as well)

# ── automatic repair when the herdr server starts ──
# DEVLAYOUT_STARTUP=0                         # 1: restart editor/review in every tab with the layout at server start
# DEVLAYOUT_STARTUP_AGENT=0                   # 1: also resume the agent (only if herdr does not resume it itself)

# ── other ──
# DEVLAYOUT_NOTIFY=auto                       # herdr notification for errors and skipped roles:
                                              # auto = only when there is no terminal (key binding, action, hooks) | on | off
# DEVLAYOUT_COOLDOWN=15                       # a program just started is not started again for this many seconds
# DEVLAYOUT_SHELL_WAIT=5                      # wait up to this many seconds for a pane's shell prompt; if it still
                                              # can't be confirmed, nothing is typed into that pane
# DEVLAYOUT_LABEL_AGENT=claude                # pane labels
# DEVLAYOUT_LABEL_EDITOR=nvim
# DEVLAYOUT_LABEL_REVIEW=reviewr
